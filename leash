#!/usr/bin/env bash
# leash - run a coding agent sandboxed with nono, scoped to the current
# project, honoring a .gitignore-style .nono_ignore file for deny rules.
set -euo pipefail

STATE_DIR=".nono"
IGNORE_FILE=".nono_ignore"

die() {
  echo "leash: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: leash <tool> [args...]

Runs <tool> (e.g. claude, codex) sandboxed with nono, scoped to this
project. Respects .nono_ignore (.gitignore syntax) to deny access to
specific files/dirs. Requires a nono profile named <tool> to extend
(see: nono profile list).

examples:
  leash claude
  leash codex
  leash install
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

TOOL="$1"
shift

if [ "$TOOL" = "install" ]; then
  BIN_DIR="$HOME/.local/bin"
  SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  mkdir -p "$BIN_DIR"
  ln -sf "$SCRIPT_PATH" "$BIN_DIR/leash"
  echo "leash: symlinked $SCRIPT_PATH -> $BIN_DIR/leash"

  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "leash: warning: $BIN_DIR is not on your PATH. Add it, e.g.: export PATH=\"$BIN_DIR:\$PATH\"" ;;
  esac

  exit 0
fi

PROFILE_PATH="$STATE_DIR/$TOOL.profile.json"
HASH_PATH="$STATE_DIR/$TOOL.ignore.sha256"
# Fallback store for filesystem grants absorbed from nono's post-session
# save-profile prompt that can't be expressed as a .nono_ignore pattern
# (allow/read/write grants, or paths outside $WORKDIR). Folded into the
# generated profile on every rebuild, alongside .nono_ignore.
EXTRA_PATH="$STATE_DIR/$TOOL.extra.json"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not found in PATH."
}

require_cmd nono
require_cmd git
require_cmd jq
require_cmd "$TOOL"

PROJECT_ROOT="$(pwd)"

git -C "$PROJECT_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "current directory is not a git repository (leash needs git to resolve .nono_ignore patterns). Run 'git init' first."

REPO_ROOT="$(git -C "$PROJECT_ROOT" rev-parse --show-toplevel)"
if [ "$REPO_ROOT" != "$PROJECT_ROOT" ]; then
  die "run leash from the repository root ($REPO_ROOT), not a subdirectory."
fi

PROJECT_SLUG="$(basename "$PROJECT_ROOT" | tr -c "a-zA-Z0-9" "-" | tr -s "-")"
PROJECT_SLUG="${PROJECT_SLUG%-}"
PROJECT_SLUG="${PROJECT_SLUG#-}"
PROFILE_NAME="leash-${TOOL}-${PROJECT_SLUG}"

hash_ignore_file() {
  local ignore_hash extra_hash
  if [ -f "$IGNORE_FILE" ]; then
    ignore_hash="$(shasum -a 256 "$IGNORE_FILE" | awk '{print $1}')"
  else
    ignore_hash="no-ignore-file"
  fi
  if [ -f "$EXTRA_PATH" ]; then
    extra_hash="$(shasum -a 256 "$EXTRA_PATH" | awk '{print $1}')"
  else
    extra_hash="no-extra-file"
  fi
  echo "$ignore_hash $extra_hash"
}

# Resolve .nono_ignore into concrete paths to deny, using git's own
# gitignore-pattern matcher so we get correct semantics (negation, **,
# anchoring) for free. --directory collapses whole ignored untracked
# directories into a single entry instead of listing every file inside.
# Paths are newline-delimited on output (filenames containing a literal
# newline are not supported).
compute_deny_paths() {
  [ -f "$IGNORE_FILE" ] || return 0
  git -C "$PROJECT_ROOT" ls-files -z \
    --cached --others --directory --no-empty-directory \
    --ignored --exclude-from="$IGNORE_FILE" \
    | while IFS= read -r -d "" path; do
        printf "%s\\n" "${path%/}"
      done
}

extra_field() {
  # Reads one array field ("deny"/"allow"/"read"/"write") out of $EXTRA_PATH.
  [ -f "$EXTRA_PATH" ] || return 0
  jq -r --arg key "$1" '.[$key] // [] | .[]' "$EXTRA_PATH"
}

ensure_gitignore_has_state_dir() {
  touch .gitignore
  grep -qxF "$STATE_DIR/" .gitignore || printf "%s\n" "$STATE_DIR/" >> .gitignore
}

build_profile() {
  touch "$IGNORE_FILE"
  mkdir -p "$STATE_DIR"
  ensure_gitignore_has_state_dir

  local tmp_profile
  tmp_profile="$(mktemp)"

  [ -f "$STATE_DIR/nono-profile.schema.json" ] \
    || nono profile schema -o "$STATE_DIR/nono-profile.schema.json"

  # Extra allow/read/write grants win over .nono_ignore-derived denies for
  # the same path, so paths the user explicitly allowed at a save-profile
  # prompt don't stay silently denied after being absorbed.
  local allow_json read_json write_json
  allow_json="$(extra_field allow | jq -Rs 'split("\n") | map(select(length > 0)) | unique')"
  read_json="$(extra_field read | jq -Rs 'split("\n") | map(select(length > 0)) | unique')"
  write_json="$(extra_field write | jq -Rs 'split("\n") | map(select(length > 0)) | unique')"

  local deny_json
  deny_json="$(
    {
      compute_deny_paths | sed "s|^|\$WORKDIR/|"
      printf "%s\\n" "\$WORKDIR/$IGNORE_FILE"
      extra_field deny
    } | jq -Rs --argjson allow "$allow_json" --argjson read "$read_json" --argjson write "$write_json" '
      split("\n") | map(select(length > 0)) | unique
      | . - ($allow + $read + $write)
    '
  )"

  local project_slug="$PROJECT_SLUG"

  jq -n \
    --arg name "$PROFILE_NAME" \
    --arg desc "Generated by leash. Do not edit by hand; edit .nono_ignore instead." \
    --arg extends "$TOOL" \
    --argjson deny "$deny_json" \
    --argjson allow "$allow_json" \
    --argjson read "$read_json" \
    --argjson write "$write_json" \
    '{
      "$schema": "./nono-profile.schema.json",
      extends: $extends,
      meta: { name: $name, description: $desc },
      security: { capability_elevation: true },
      filesystem: {
        deny: $deny,
        allow: $allow,
        read: $read,
        write: $write
      }
    } | .filesystem |= with_entries(select(.value | length > 0))
      | if (.filesystem | length) == 0 then del(.filesystem) else . end' > "$tmp_profile"

  mv "$tmp_profile" "$PROFILE_PATH"
  hash_ignore_file > "$HASH_PATH"

  nono profile validate "$PROFILE_PATH" \
    || die "generated profile failed validation (see above). This is a leash bug - please report it."
}

needs_rebuild() {
  [ ! -f "$PROFILE_PATH" ] && return 0
  [ ! -f "$HASH_PATH" ] && return 0
  [ "$(cat "$HASH_PATH")" != "$(hash_ignore_file)" ] && return 0
  return 1
}

# nono's post-session save-profile prompt writes the user's allow/deny/skip
# choices into its own config - either a not-yet-applied draft
# ($cfg_dir/profile-drafts/<name>.json) or (once confirmed) directly into a
# user-level profile ($cfg_dir/profiles/<name>.json). <name> is NOT reliably
# our generated profile's meta.name ($PROFILE_NAME): nono attributes a given
# deny rule's save-prompt to whichever profile in the extends chain actually
# owns that rule, so a denial coming from "$TOOL"'s own base/pack profile
# (its default deny groups, e.g. credentials) gets saved under plain "$TOOL",
# not under our leash-generated name. Check both. Neither location is ever
# read by a subsequent `leash` run on its own, so left alone those choices
# are silently discarded every time. Pull them back into the project: deny
# paths under $WORKDIR become .nono_ignore lines (the preferred,
# human-readable source of truth); anything that can't be expressed there
# (allow/read/write grants, or paths outside the project) falls back to
# $EXTRA_PATH. Once a draft or promoted file's grants are folded in, it's
# deleted - its content now lives in the project (.nono_ignore/$EXTRA_PATH),
# so leaving the global copy around would just get it silently re-absorbed
# (and re-noted) on every subsequent run.
absorb_session_grants() {
  local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nono"

  local name
  local absorbed=0
  for name in "$PROFILE_NAME" "$TOOL"; do
    local draft_file="$cfg_dir/profile-drafts/$name.json"
    local promoted_file="$cfg_dir/profiles/$name.json"

    local src
    for src in "$draft_file" "$promoted_file"; do
      [ -f "$src" ] || continue
      jq empty "$src" >/dev/null 2>&1 || continue

      local deny_paths allow_paths read_paths write_paths
      deny_paths="$(jq -r '.filesystem.deny // [] | .[]' "$src" 2>/dev/null || true)"
      allow_paths="$(jq -r '.filesystem.allow // [] | .[]' "$src" 2>/dev/null || true)"
      read_paths="$(jq -r '.filesystem.read // [] | .[]' "$src" 2>/dev/null || true)"
      write_paths="$(jq -r '.filesystem.write // [] | .[]' "$src" 2>/dev/null || true)"

      [ -z "$deny_paths$allow_paths$read_paths$write_paths" ] && continue
      absorbed=1

      local rel line
      if [ -n "$deny_paths" ]; then
        while IFS= read -r line; do
          [ -n "$line" ] || continue
          case "$line" in
            '$WORKDIR/'*)
              rel="${line#\$WORKDIR/}"
              grep -qxF "$rel" "$IGNORE_FILE" 2>/dev/null || printf "%s\n" "$rel" >> "$IGNORE_FILE"
              ;;
            *)
              append_extra deny "$line"
              ;;
          esac
        done <<< "$deny_paths"
      fi

      while IFS= read -r line; do
        [ -n "$line" ] && append_extra allow "$line"
      done <<< "$allow_paths"
      while IFS= read -r line; do
        [ -n "$line" ] && append_extra read "$line"
      done <<< "$read_paths"
      while IFS= read -r line; do
        [ -n "$line" ] && append_extra write "$line"
      done <<< "$write_paths"

      if [ "$src" = "$draft_file" ]; then
        rm -f -- "$draft_file" "$cfg_dir/profile-drafts/$name.base"
      else
        rm -f -- "$promoted_file"
      fi
    done
  done

  if [ "$absorbed" -eq 1 ]; then
    strip_ignore_lines_covered_by_extra
    echo "leash: absorbed nono's save-profile choices into $IGNORE_FILE / $EXTRA_PATH" >&2
    build_profile
  fi
}

append_extra() {
  local key="$1" value="$2"
  [ -f "$EXTRA_PATH" ] || echo '{"deny":[],"allow":[],"read":[],"write":[]}' > "$EXTRA_PATH"
  local tmp
  tmp="$(mktemp)"
  jq --arg key "$key" --arg value "$value" \
    '.[$key] = ((.[$key] // []) + [$value] | unique)' \
    "$EXTRA_PATH" > "$tmp"
  mv "$tmp" "$EXTRA_PATH"
}

# If a path was granted via allow/read/write, drop any matching literal
# .nono_ignore line so it isn't re-denied on the next rebuild.
strip_ignore_lines_covered_by_extra() {
  [ -f "$IGNORE_FILE" ] && [ -f "$EXTRA_PATH" ] || return 0
  local granted
  granted="$(jq -r '(.allow // []) + (.read // []) + (.write // []) | .[]' "$EXTRA_PATH" \
    | sed -n 's|^\$WORKDIR/||p')"
  [ -n "$granted" ] || return 0

  local tmp
  tmp="$(mktemp)"
  local line skip
  while IFS= read -r line || [ -n "$line" ]; do
    skip=0
    while IFS= read -r g; do
      [ "$line" = "$g" ] && skip=1 && break
    done <<< "$granted"
    [ "$skip" -eq 0 ] && printf "%s\n" "$line" >> "$tmp"
  done < "$IGNORE_FILE"
  mv "$tmp" "$IGNORE_FILE"
}

if needs_rebuild; then
  build_profile
fi

set +e
nono run \
  -v \
  --allow-cwd \
  --profile "$PROJECT_ROOT/$PROFILE_PATH" \
  --workdir "$PROJECT_ROOT" \
  -- "$TOOL" "$@"
STATUS=$?
set -e

absorb_session_grants

exit "$STATUS"

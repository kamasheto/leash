#!/usr/bin/env python3
"""leash - run a coding agent sandboxed with nono, scoped to the current
project, honoring a .gitignore-style .leash file for deny rules.

The only external dependencies are `git` and `nono` - JSON is handled with
the standard library, so `jq` is not required.

Install: ./cli install   (symlinks this file into ~/.local/bin/leash)
"""

import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

STATE_DIR = ".leash-agents"
IGNORE_FILE = ".leash"

quote = shlex.quote  # for dropping a variable into a run_cmd() command string


# ---------------------------------------------------------------------------
# Paths - every filesystem location leash cares about for one (tool, project)
# pair, computed once in main() and threaded through the rest of the module.
# ---------------------------------------------------------------------------

class Paths:
    def __init__(self, tool: str, project_root: Path):
        self.tool = tool
        self.project_root = project_root
        self.ignore_path = project_root / IGNORE_FILE
        self.profile_path = project_root / STATE_DIR / f"{tool}.profile.json"
        self.hash_path = project_root / STATE_DIR / f"{tool}.ignore.sha256"
        self.extra_path = project_root / STATE_DIR / f"{tool}.extra.json"
        self.schema_path = project_root / STATE_DIR / "nono-profile.schema.json"
        self.profile_name = f"leash-{tool}-{slugify(project_root.name)}"


def slugify(name: str) -> str:
    return re.sub(r"[^a-zA-Z0-9]+", "-", name).strip("-")


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def die(message: str) -> None:
    print(f"leash: {message}", file=sys.stderr)
    sys.exit(1)


def usage() -> None:
    print("""usage: leash <tool> [args...]

Runs <tool> (e.g. claude, codex) sandboxed with nono, scoped to this
project. Respects `.leash` (.gitignore syntax) to deny access to
specific files/dirs. Requires a nono profile named <tool> to extend
(see: nono profile list).

examples:
  leash claude
  leash codex
  leash install""")


def require_cmd(name: str) -> None:
    from shutil import which
    if which(name) is None:
        die(f"'{name}' is required but not found in PATH.")


def run_cmd(cmd: str, **kwargs) -> subprocess.CompletedProcess:
    """Run a normal-looking bash command string, e.g. run_cmd(f"git -C {quote(root)} status").

    Splits it with shlex (so quoted arguments, e.g. from quote(), survive intact)
    and hands the resulting argv straight to subprocess.run - no shell involved.
    """
    return subprocess.run(shlex.split(cmd), **kwargs)


def write_atomic(path: Path, text: str) -> None:
    """Write via a temp file + rename, so a reader never sees a partial file."""
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=".leash-tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise


def unique_sorted(items: list[str]) -> list[str]:
    return sorted({item for item in items if item})


# ---------------------------------------------------------------------------
# install subcommand
# ---------------------------------------------------------------------------

def run_install() -> None:
    self_path = Path(__file__).resolve()
    bin_dir = Path.home() / ".local" / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)

    target = bin_dir / "leash"
    target.unlink(missing_ok=True)
    target.symlink_to(self_path)
    print(f"leash: symlinked {self_path} -> {target}")

    path_env = f":{os.environ.get('PATH', '')}:"
    if f":{bin_dir}:" not in path_env:
        print(f"leash: warning: {bin_dir} is not on your PATH. "
              f"Add it, e.g.: export PATH=\"{bin_dir}:$PATH\"")


# ---------------------------------------------------------------------------
# git-backed .leash resolution
# ---------------------------------------------------------------------------

def compute_deny_paths(p: Paths) -> list[str]:
    """Resolve .leash into concrete repo-relative paths to deny, using
    git's own gitignore-pattern matcher (negation, **, anchoring) instead of
    reimplementing it. --directory collapses whole ignored untracked
    directories into a single entry."""
    if not p.ignore_path.exists():
        return []
    out = run_cmd(
        f"git -C {quote(str(p.project_root))} ls-files -z --cached --others "
        f"--directory --no-empty-directory --ignored --exclude-from={quote(str(p.ignore_path))}",
        check=True, capture_output=True, text=True,
    ).stdout
    return [entry.rstrip("/") for entry in out.split("\0") if entry]


# ---------------------------------------------------------------------------
# .nono/<tool>.extra.json - grants that .leash can't express
# ---------------------------------------------------------------------------

def load_extra(path: Path) -> dict[str, list[str]]:
    empty = {"deny": [], "allow": [], "read": [], "write": []}
    if not path.exists():
        return empty
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return empty  # malformed extra file: ignore, same as bash's jq guard
    return {key: list(data.get(key) or []) for key in empty}


def save_extra(path: Path, extra: dict[str, list[str]]) -> None:
    normalized = {key: unique_sorted(values) for key, values in extra.items()}
    write_atomic(path, json.dumps(normalized, indent=2) + "\n")


def append_extra(extra_path: Path, key: str, value: str) -> None:
    extra = load_extra(extra_path)
    extra[key].append(value)
    save_extra(extra_path, extra)


# ---------------------------------------------------------------------------
# Change detection: skip rebuilding the profile when nothing that feeds it
# has changed.
# ---------------------------------------------------------------------------

def hash_or_sentinel(path: Path, sentinel: str) -> str:
    if not path.exists():
        return sentinel
    return hashlib.sha256(path.read_bytes()).hexdigest()


def hash_state(p: Paths) -> str:
    return f"{hash_or_sentinel(p.ignore_path, 'no-ignore-file')} {hash_or_sentinel(p.extra_path, 'no-extra-file')}"


def needs_rebuild(p: Paths) -> bool:
    if not p.profile_path.exists() or not p.hash_path.exists():
        return True
    return p.hash_path.read_text() != hash_state(p)


# ---------------------------------------------------------------------------
# .gitignore upkeep
# ---------------------------------------------------------------------------

def ensure_gitignore_has_state_dir(project_root: Path) -> None:
    path = project_root / ".gitignore"
    lines = path.read_text().splitlines() if path.exists() else []
    if f"{STATE_DIR}/" in lines:
        return
    with path.open("a") as f:
        f.write(f"{STATE_DIR}/\n")


# ---------------------------------------------------------------------------
# Profile generation
# ---------------------------------------------------------------------------

def build_profile(p: Paths) -> None:
    if not p.ignore_path.exists():
        p.ignore_path.write_text("""# `.gitignore` syntax deny-list
# list of files to explicitly restrict access to your agent
# only relevant if running your agent behind `leash`
# read more: https://github.com/kamasheto/leash

""")
    (p.project_root / STATE_DIR).mkdir(parents=True, exist_ok=True)
    ensure_gitignore_has_state_dir(p.project_root)

    if not p.schema_path.exists():
        run_cmd(f"nono profile schema -o {quote(str(p.schema_path))}", check=True)

    extra = load_extra(p.extra_path)

    deny_raw = [f"$WORKDIR/{path}" for path in compute_deny_paths(p)]
    deny_raw.append(f"$WORKDIR/{IGNORE_FILE}")
    deny_raw.extend(extra["deny"])

    # Extra allow/read/write grants win over .leash-derived denies for
    # the same path, so paths explicitly allowed at a save-profile prompt
    # don't stay silently denied after being absorbed.
    allow = unique_sorted(extra["allow"])
    read = unique_sorted(extra["read"])
    write = unique_sorted(extra["write"])
    granted = set(allow) | set(read) | set(write)
    deny = [path for path in unique_sorted(deny_raw) if path not in granted]

    profile = {
        "$schema": "./nono-profile.schema.json",
        "extends": p.tool,
        "meta": {
            "name": p.profile_name,
            "description": "Generated by leash. Do not edit by hand; edit .leash instead.",
        },
        "security": {"capability_elevation": True},
    }
    filesystem = {}
    if deny:
        filesystem["deny"] = deny
    if allow:
        filesystem["allow"] = allow
    if read:
        filesystem["read"] = read
    if write:
        filesystem["write"] = write
    if filesystem:
        profile["filesystem"] = filesystem

    write_atomic(p.profile_path, json.dumps(profile, indent=2) + "\n")
    p.hash_path.write_text(hash_state(p))

    result = run_cmd(f"nono profile validate {quote(str(p.profile_path))}")
    if result.returncode != 0:
        die("generated profile failed validation (see above). This is a leash bug - please report it.")


# ---------------------------------------------------------------------------
# Absorbing nono's post-session save-profile prompt
#
# nono's own save-profile prompt (shown after a session, for paths the agent
# tried to access) writes its answers to nono's global config, keyed by a
# profile name - either a not-yet-applied draft
# ($cfg_dir/profile-drafts/<name>.json) or, once confirmed, directly into a
# user-level profile ($cfg_dir/profiles/<name>.json). <name> is NOT reliably
# our generated profile's meta.name (p.profile_name): nono attributes a
# given deny rule's save-prompt to whichever profile in the extends chain
# actually owns that rule, so a denial coming from <tool>'s own base/pack
# profile (its default deny groups, e.g. credentials) gets saved under plain
# <tool>, not under our leash-generated name. We check both.
#
# Neither location is ever read by a subsequent `leash` run on its own, so
# left alone those choices are silently discarded every time. We pull them
# back into the project: deny paths under $WORKDIR become .leash
# lines (the preferred, human-readable source of truth); anything that can't
# be expressed there (allow/read/write grants, or paths outside the project)
# falls back to .nono/<tool>.extra.json. Once a draft or promoted file's
# grants are folded in, it's deleted - its content now lives in the project,
# so leaving the global copy around would just get it silently re-absorbed
# on every subsequent run.
# ---------------------------------------------------------------------------

def nono_config_dir() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "nono"


def append_ignore_line(ignore_path: Path, rel: str) -> None:
    lines = ignore_path.read_text().splitlines() if ignore_path.exists() else []
    if rel in lines:
        return
    with ignore_path.open("a") as f:
        f.write(rel + "\n")


def absorb_from(p: Paths, src: Path, is_draft: bool) -> bool:
    if not src.exists():
        return False
    try:
        data = json.loads(src.read_text())
    except (json.JSONDecodeError, OSError):
        return False  # malformed: ignore, same as bash's `jq empty` guard

    fs = data.get("filesystem") or {}
    deny = fs.get("deny") or []
    allow = fs.get("allow") or []
    read = fs.get("read") or []
    write = fs.get("write") or []
    if not (deny or allow or read or write):
        return False

    for path in deny:
        if path.startswith("$WORKDIR/"):
            append_ignore_line(p.ignore_path, path.removeprefix("$WORKDIR/"))
        else:
            append_extra(p.extra_path, "deny", path)
    for path in allow:
        append_extra(p.extra_path, "allow", path)
    for path in read:
        append_extra(p.extra_path, "read", path)
    for path in write:
        append_extra(p.extra_path, "write", path)

    src.unlink(missing_ok=True)
    if is_draft:
        src.with_suffix(".base").unlink(missing_ok=True)
    return True


def absorb_session_grants(p: Paths) -> None:
    cfg_dir = nono_config_dir()
    absorbed = False

    for name in (p.profile_name, p.tool):
        draft = cfg_dir / "profile-drafts" / f"{name}.json"
        promoted = cfg_dir / "profiles" / f"{name}.json"
        absorbed = absorb_from(p, draft, is_draft=True) or absorbed
        absorbed = absorb_from(p, promoted, is_draft=False) or absorbed

    if not absorbed:
        return
    strip_ignore_lines_covered_by_extra(p)
    print(f"leash: absorbed nono's save-profile choices into {IGNORE_FILE} / {p.extra_path}", file=sys.stderr)
    build_profile(p)


def strip_ignore_lines_covered_by_extra(p: Paths) -> None:
    """If a path was granted via allow/read/write, drop any matching literal
    .leash line so it isn't re-denied on the next rebuild."""
    if not p.ignore_path.exists():
        return
    extra = load_extra(p.extra_path)
    granted = {
        path.removeprefix("$WORKDIR/")
        for path in extra["allow"] + extra["read"] + extra["write"]
        if path.startswith("$WORKDIR/")
    }
    if not granted:
        return
    lines = p.ignore_path.read_text().splitlines()
    kept = [line for line in lines if line not in granted]
    write_atomic(p.ignore_path, "\n".join(kept) + ("\n" if kept else ""))


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main() -> None:
    args = sys.argv[1:]
    if not args:
        usage()
        return

    tool, tool_args = args[0], args[1:]

    if tool == "install":
        run_install()
        return

    require_cmd("nono")
    require_cmd("git")
    require_cmd(tool)

    project_root = Path.cwd()

    if run_cmd(
        f"git -C {quote(str(project_root))} rev-parse --is-inside-work-tree",
        capture_output=True,
    ).returncode != 0:
        die("current directory is not a git repository (leash needs git to resolve "
            ".leash patterns). Run 'git init' first.")

    repo_root = run_cmd(
        f"git -C {quote(str(project_root))} rev-parse --show-toplevel",
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    if repo_root != str(project_root):
        die(f"run leash from the repository root ({repo_root}), not a subdirectory.")

    p = Paths(tool=tool, project_root=project_root)

    if needs_rebuild(p):
        build_profile(p)

    tool_cmd = " ".join(quote(arg) for arg in (tool, *tool_args))
    result = run_cmd(
        f"nono run -v --allow-cwd --profile {quote(str(p.profile_path))} "
        f"--workdir {quote(str(project_root))} -- {tool_cmd}"
    )

    absorb_session_grants(p)

    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
